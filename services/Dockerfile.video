# 视频服务：仓库根目录为 context，把演示封面/样片打进镜像。
# docker build -f services/Dockerfile.video --build-arg PORT=8083 -t doinb-video:local .
FROM eclipse-temurin:25-jdk AS builder
WORKDIR /build
COPY services/ .
COPY database/seed.sql /database/seed.sql
ARG MODULE=doinb-video
RUN --mount=type=cache,target=/root/.m2 \
    sed -i 's/\r$//' mvnw && chmod +x mvnw && ./mvnw -B -pl ${MODULE} -am package -DskipTests

FROM eclipse-temurin:25-jre
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ARG MODULE=doinb-video
ARG PORT=8083
ARG APP_VERSION=dev
ENV SERVER_PORT=${PORT}
ENV APP_VERSION=${APP_VERSION}
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=20.0 -XX:+UseG1GC"
COPY --from=builder /build/${MODULE}/target/${MODULE}-0.0.1-SNAPSHOT.jar app.jar
COPY backend/demo-media /opt/demo-media
EXPOSE ${PORT}
HEALTHCHECK --interval=15s --timeout=5s --start-period=75s --retries=5 \
  CMD curl -fs "http://127.0.0.1:${SERVER_PORT}/health" || exit 1
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
