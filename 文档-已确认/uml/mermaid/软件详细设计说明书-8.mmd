%%{init: {"theme":"base","sequence":{"showSequenceNumbers":true},"themeVariables":{"fontFamily":"Microsoft YaHei, sans-serif","background":"#ffffff","mainBkg":"#ffffff","primaryColor":"#b8d4f0","primaryTextColor":"#000000","primaryBorderColor":"#333333","secondaryColor":"#d4e8f8","secondaryTextColor":"#000000","secondaryBorderColor":"#333333","tertiaryColor":"#e8f4fc","lineColor":"#333333","textColor":"#000000","actorBkg":"#b8d4f0","actorBorder":"#333333","actorTextColor":"#000000","actorLineColor":"#333333","signalColor":"#333333","signalTextColor":"#000000","labelBoxBkgColor":"#fff5eb","labelBoxBorderColor":"#e8a050","labelTextColor":"#000000","loopTextColor":"#000000","noteBkgColor":"#fffef0","noteBorderColor":"#333333","noteTextColor":"#000000","activationBkgColor":"#8ec5eb","activationBorderColor":"#333333","sequenceNumberColor":"#ffffff"}}}%%
sequenceDiagram
    autonumber
    actor U as 用户
    participant UI as Web界面
    participant User as User
    participant Comment as Comment
    participant Video as Video
    participant Live as Live
    participant DB as 数据库

    U->>UI: 在视频/直播详情下输入评论
    UI->>User: 校验登录态
    User-->>UI: 已登录 userId
    UI->>Comment: postComment(targetId, targetType, content)
    alt targetType = 视频
        Comment->>Video: 校验目标存在且可评论
        Video-->>Comment: 有效
    else targetType = 直播
        Comment->>Live: 校验直播间状态
        Live-->>Comment: 有效
    end
    Comment->>DB: INSERT comments
    DB-->>Comment: commentId
    Comment-->>UI: true
    UI->>Comment: listComments(targetId)
    Comment->>DB: SELECT comments ORDER BY time
    DB-->>Comment: 评论列表
    Comment-->>UI: list
    UI-->>U: 刷新评论区
